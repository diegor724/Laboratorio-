int[,,] nave1 = new int[2, 3, 4];
int[,,] nave2 = new int[2, 3, 4];
string input;

int total1 = 20;

//cargamos tripulantes en la nave1 

Console.WriteLine(" Bienvenido a el Starship Tactics (Battle-Sim 3D) ");
Console.WriteLine("Primero cargaremos los datos de la nave1 ");

while (total1 > 0)
{
    int Ala1;
    int Capsula1;
    int Habitacion1;
    int carga1;


    Console.WriteLine("\nIngrese el Ala donde desea ingresar tripulantes ( 0, 1)");
    input = Console.ReadLine();
    if (int.TryParse(input, out Ala1))
    {
        if (Ala1 == 0 || Ala1 == 1)
        {
            Console.WriteLine("\nIngrese a que capsula desea ingresar ( 0,1,2)");
            input = Console.ReadLine();
            if (int.TryParse(input, out Capsula1))
            {
                if (Capsula1 < 3)
                {
                    Console.WriteLine("\nAhora ingrese a que habitacion desea resguardar a sus tripulantes ( 0,1,2,3 )");
                    input = Console.ReadLine();
                    if (int.TryParse(input, out Habitacion1))
                    {
                        if (Habitacion1 >= 0 && Habitacion1 < 4)
                        {
                            Console.WriteLine("Perfecto resguardaremos a sus tripulantes en la habitación: " + Habitacion1);
                            Console.WriteLine("Ahora diganos cuantos tripulantes desea guardar en esa habitacion: ");
                            Console.WriteLine("\nCantidad de tripulantes que tiene actualmente disponibles:" + total1);
                            input = Console.ReadLine();

                            if (!int.TryParse(input, out carga1) || carga1 < 0)
                            {
                                Console.WriteLine("Cantidad inválida.");
                                continue;
                            }

                            if (carga1 > total1)
                            {
                                Console.WriteLine("No tienes tantos tripulantes disponibles.");
                                continue;
                            }

                            nave1[Ala1, Capsula1, Habitacion1] += carga1;

                            total1 -= carga1;

                        }
                        else
                        {
                            Console.WriteLine("Numero invalido");
                        }
                    }
                    else
                    {
                        Console.WriteLine("Ingrese una habitacion existente");
                    }
                }
                else
                {
                    Console.WriteLine("Ingrese un numero valido");
                }
            }
            else
            {
                Console.WriteLine("Ingrese una capsula existente");
            }
        }
        else
        {
            Console.WriteLine("ingrese un numero valido");
        }
    }
    else
    {
        Console.WriteLine("Ingrese una ALa existente");
    }
}
